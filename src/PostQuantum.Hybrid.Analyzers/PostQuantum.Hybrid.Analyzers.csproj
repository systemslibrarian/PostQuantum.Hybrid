<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Analyzers ONLY. This assembly must not reference
    Microsoft.CodeAnalysis.Workspaces (RS1038): Workspaces is not supplied
    during command-line compilation, so an analyzer that binds against it can
    behave unpredictably there. The code fixes, which genuinely need Workspaces
    to rewrite a Document, live in PostQuantum.Hybrid.CodeFixes.

    That project also builds the NuGet package, because it references this one
    and therefore has both DLLs in its output. The package id is unchanged.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>PostQuantum.Hybrid.Analyzers</RootNamespace>
    <AssemblyName>PostQuantum.Hybrid.Analyzers</AssemblyName>

    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>false</IsPackable>
    <!-- Distinct from the AssemblyName so NuGet does not see the same identity
         as a project and as the package id the CodeFixes project produces. -->
    <PackageId>PostQuantum.Hybrid.Analyzers.Impl</PackageId>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>

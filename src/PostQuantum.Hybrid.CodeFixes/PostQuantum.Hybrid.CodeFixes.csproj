<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Code fixes, and the packaging for the PostQuantum.Hybrid.Analyzers NuGet
    package. Split from the analyzers to satisfy RS1038 — see that project.

    Packaging lives here rather than there because the dependency only runs one
    way: a code fix names the analyzer's DiagnosticId, so CodeFixes references
    Analyzers and has BOTH DLLs in its output. The reverse would be circular.
    `dotnet pack` on this project produces the same package id and layout as
    before the split; consumers see two DLLs under analyzers/dotnet/cs instead
    of one.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>PostQuantum.Hybrid.Analyzers</RootNamespace>
    <AssemblyName>PostQuantum.Hybrid.CodeFixes</AssemblyName>

    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>

    <IsPackable>true</IsPackable>
    <PackageId>PostQuantum.Hybrid.Analyzers</PackageId>
    <Version>1.2.0</Version>
    <Authors>Paul Clark</Authors>
    <Description>Roslyn analyzers for PostQuantum.Hybrid. Detects common misuse patterns at build time: undisposed hybrid private keys, encapsulation results, and key pairs.</Description>
    <PackageTags>analyzers;roslyn;cryptography;post-quantum;pqc;hybrid;PostQuantum.Hybrid</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/systemslibrarian/PostQuantum.Hybrid</PackageProjectUrl>
    <RepositoryUrl>https://github.com/systemslibrarian/PostQuantum.Hybrid</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PostQuantum.Hybrid.Analyzers/PostQuantum.Hybrid.Analyzers.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)/PostQuantum.Hybrid.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)/PostQuantum.Hybrid.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../PostQuantum.Hybrid.Analyzers/README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
